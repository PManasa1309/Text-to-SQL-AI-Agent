# =============================================================================
# Text-to-SQL Agent — Environment Configuration Template
# 1. Copy this file:  copy .env.example .env  (Windows)
#                     cp  .env.example .env   (macOS/Linux)
# 2. Fill in your REAL values in .env.
# 3. NEVER commit .env to version control — it is already in .gitignore.
# =============================================================================

# ── LLM Provider (only "groq" is supported) ─────────────────────────────────
LLM_PROVIDER=groq

# ── Google Gemini API Key ─────────────────────────────────────────────────────
# Get your FREE key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# ── MySQL Database Credentials ────────────────────────────────────────────────
# The app will auto-create the database and tables on first run.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=company_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
